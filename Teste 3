from datetime import datetime

def calcular_juros(valor, data_vencimento):
    # Formato da data: DD/MM/AAAA
    vencimento = datetime.strptime(data_vencimento, "%d/%m/%Y").date()
    hoje = datetime.today().date()

    dias_atraso = (hoje - vencimento).days

    if dias_atraso <= 0:
        return {
            "valor_original": valor,
            "dias_atraso": 0,
            "juros": 0,
            "valor_total": valor
        }

    juros = valor * 0.025 * dias_atraso
    valor_total = valor + juros

    return {
        "valor_original": valor,
        "dias_atraso": dias_atraso,
        "juros": juros,
        "valor_total": valor_total
    }


# Exemplo de uso
valor = 1000.00
data_vencimento = "20/09/2026"

resultado = calcular_juros(valor, data_vencimento)

print(f"Valor Original: R$ {resultado['valor_original']:.2f}")
print(f"Dias de atraso: {resultado['dias_atraso']}")
print(f"Juros: R$ {resultado['juros']:.2f}")
print(f"Valor Total: R$ {resultado['valor_total']:.2f}")